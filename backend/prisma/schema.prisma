// -----------------------------------------------------------------------------
// Gestor de Objetivos de Aprendizaje — esquema de base de datos (PostgreSQL)
// -----------------------------------------------------------------------------
// Todas las entidades de contenido cuelgan de un User. Esto garantiza el
// aislamiento de datos: cada profesora sólo ve y modifica lo suyo.
// -----------------------------------------------------------------------------

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ObjectiveStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ObjectivePriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses    Course[]
  subjects   Subject[]
  units      Unit[]
  objectives LearningObjective[]

  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// -----------------------------------------------------------------------------
// Tokens de recuperación de contraseña.
// -----------------------------------------------------------------------------
// NUNCA se guarda el token que viaja en el enlace: sólo su hash SHA-256. Si
// alguien lee la base de datos no puede reconstruir ningún enlace válido.
// Cada token es de un solo uso (`usedAt`) y caduca (`expiresAt`).
// -----------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Course {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  units      Unit[]
  objectives LearningObjective[]

  @@unique([userId, name])
  @@index([userId])
  @@map("courses")
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#2563eb")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  units      Unit[]
  objectives LearningObjective[]

  @@unique([userId, name])
  @@index([userId])
  @@map("subjects")
}

model Unit {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  objectives LearningObjective[]

  @@unique([userId, subjectId, courseId, name])
  @@index([userId])
  @@index([subjectId])
  @@index([courseId])
  @@map("units")
}

model LearningObjective {
  id          String            @id @default(uuid())
  code        String
  title       String
  description String?
  order       Int               @default(0)
  status      ObjectiveStatus   @default(PENDING)
  priority    ObjectivePriority @default(MEDIUM)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([unitId])
  @@index([subjectId])
  @@index([courseId])
  @@index([userId, order])
  @@map("learning_objectives")
}
