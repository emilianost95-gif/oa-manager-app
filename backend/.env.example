# Conexión a PostgreSQL (debe coincidir con docker-compose.yml)
DATABASE_URL="postgresql://oa_user:oa_password@localhost:5432/oa_manager?schema=public"

# Secreto para firmar los JWT. Cámbialo por una cadena larga y aleatoria.
# Puedes generar uno con:  openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Duración de la sesión
JWT_EXPIRES_IN="7d"

# Puerto del backend
PORT=4000

# development | production
NODE_ENV=development

# Orígenes permitidos por CORS (separados por comas)
FRONTEND_URL="http://localhost:5173"

# --- Recuperación de contraseña ---------------------------------------------
# Minutos que dura el enlace de recuperación (1 a 1440). Por defecto 60.
PASSWORD_RESET_TTL_MINUTES=60

# URL pública del frontend, usada para construir el enlace del correo.
# Si se omite se usa el primer origen de FRONTEND_URL.
# En producción: PUBLIC_APP_URL="https://oa-manager-app.netlify.app"
PUBLIC_APP_URL="http://localhost:5173"

# --- Envío de correo (Resend) -----------------------------------------------
# Ambas variables deben definirse juntas; si falta una, no se envía nada y en
# desarrollo el enlace de recuperación se imprime en la consola del backend.
# La API key se crea en https://resend.com/api-keys
RESEND_API_KEY=""
# Remitente. El dominio debe estar verificado en Resend.
# Para pruebas puedes usar "OA Manager <onboarding@resend.dev>", que sólo
# entrega correos a la dirección con la que creaste la cuenta de Resend.
MAIL_FROM="OA Manager <no-reply@tu-dominio.cl>"
