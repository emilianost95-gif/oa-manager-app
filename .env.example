# ---------------------------------------------------------------------------
# Variables de entorno del proyecto "Gestor de Objetivos de Aprendizaje"
# Copia este archivo:
#   cp .env.example backend/.env
#   cp .env.example .env          (opcional, para docker compose)
# ---------------------------------------------------------------------------

# Conexión a PostgreSQL (debe coincidir con docker-compose.yml)
DATABASE_URL="postgresql://oa_user:oa_password@localhost:5432/oa_manager?schema=public"

# Secreto para firmar los JWT. Cámbialo por una cadena larga y aleatoria.
# Puedes generar uno con:  openssl rand -base64 48
JWT_SECRET="ZN1iexThml7Z+6wsnHKFUd0gqz8IzE0YGh72tJMK7uqMLBxg6X8HEFHBiWRDGyhz"

# Duración de la sesión
JWT_EXPIRES_IN="7d"

# Puerto del backend
PORT=4000

# Entorno: development | production
NODE_ENV=development

# URL del frontend (para CORS y cookies). Separar con comas si hay varias.
FRONTEND_URL="http://localhost:5173"

# --- Solo frontend (frontend/.env) -----------------------------------------
# URL base de la API que consume el frontend
VITE_API_URL="http://localhost:4000/api"
